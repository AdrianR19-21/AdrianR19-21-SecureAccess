# Configuración para subida de imágenes a servicios externos

# Opción 1: Cloudinary (RECOMENDADO - Gratuito con capacidad superior)
# 1. Crea cuenta en https://cloudinary.com (gratuito)
# 2. Ve a Dashboard > Settings > Upload
# 3. Busca "Upload presets" y crea uno nuevo (unsigned upload)
# 4. Copia estos valores:
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_UPLOAD_PRESET=tu_upload_preset_name

# Opción 2: Si NO configuras Cloudinary, la app usa imgbb automáticamente
# imgbb tiene un tier gratuito generoso sin necesidad de configuración adicional

# El endpoint /api/upload intenta primero Cloudinary
# Si Cloudinary no está configurado, cae automáticamente a imgbb
