// Archivo de configuracion de Prisma para tu base de datos SQLite

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  links     Link[]
  vault     VaultEntry[]
}

model Link {
  id            String   @id @default(uuid())
  title         String?
  url           String
  notes         String?
  keywords      String?
  imageDataUrl  String?
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
  userId        Int
}

model VaultEntry {
  id          String   @id @default(uuid())
  title       String
  siteUrl     String?
  loginName   String?
  secretValue String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
}
